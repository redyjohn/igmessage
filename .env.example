# Use a disposable/secondary Instagram account only. Do not use your main account.
# Still against Instagram ToS when scraping others' posts — account lock risk remains.
IG_USERNAME=your_secondary_instagram_username
IG_PASSWORD=your_secondary_instagram_password
HEADLESS=false
CRAWL_TIMEOUT_SECONDS=60
MAX_RETRIES=3
MAX_COMMENTS=0
CRAWL_DELAY_SECONDS=3.0
SKIP_PDF=false
ALLOW_IG_CRAWL=true
# Time window (Asia/Taipei if timezone omitted). Examples:
# This run: only comments strictly before noon
COMMENT_BEFORE=2026-07-25T12:00:00+08:00
COMMENT_AFTER=
# Next run: only comments from 12:01 onward
# COMMENT_BEFORE=
# COMMENT_AFTER=2026-07-25T12:01:00+08:00
